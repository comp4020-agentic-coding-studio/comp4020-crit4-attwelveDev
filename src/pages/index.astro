---
import { CONSTELLATION } from "../data/constellation";
import "../styles/global.css";

// Background scatter of stars, purely decorative. Generated once at build
// time rather than by client JS: a static site doesn't need a script to draw
// something that never has to respond to anything, and it means the sky is
// there the instant the HTML parses, before any script has run.
const STAR_COUNT = 110;
const stars = Array.from({ length: STAR_COUNT }, () => ({
  x: Math.random() * 100,
  y: Math.random() * 100,
  size: 0.6 + Math.random() * 1.6,
  duration: 3 + Math.random() * 6,
  delay: -Math.random() * 8,
  peak: 0.3 + Math.random() * 0.7,
}));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Field — a navigable instrument</title>
    <meta
      name="description"
      content="Move through a field of words and hear what you are near. A browser instrument built for COMP4020."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <!--
      A skip link rather than visible chrome. The page still needs a navigation
      landmark, and on a single-page instrument the only navigation worth
      having is a way past the field --- which captures the arrow keys --- to
      the controls after it. Invisible until it is focused.
    -->
    <header>
      <nav aria-label="Primary">
        <a class="skip" href="#controls">Skip to controls</a>
      </nav>
    </header>

    <main>
      <h1>Field</h1>

      <div class="field" data-testid="field">
        <div class="starfield" aria-hidden="true">
          {
            stars.map((star) => (
              <span
                class="star"
                style={`left: ${star.x}%; top: ${star.y}%; width: ${star.size}px; height: ${star.size}px; --duration: ${star.duration}s; --delay: ${star.delay}s; --peak: ${star.peak};`}
              />
            ))
          }
        </div>

        <!--
          One line per prompt, from the travelling point to that prompt's
          position. x1/y1 are updated every frame in main.ts; x2/y2 are fixed,
          so only the constellation's centre moves, the way a real one would
          look from a point drifting among fixed stars. Opacity is driven by
          the same blend weight that brightens the prompt's own label, so the
          lines are a second rendering of one number, not decoration invented
          separately from what is actually sounding.
        -->
        <svg
          class="constellation-lines"
          data-testid="lines"
          viewBox="0 0 100 100"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          {
            CONSTELLATION.map((prompt, index) => (
              <line
                data-line={index}
                x1="50"
                y1="50"
                x2={prompt.at.x * 100}
                y2={(1 - prompt.at.y) * 100}
                vector-effect="non-scaling-stroke"
              />
            ))
          }
        </svg>

        {
          CONSTELLATION.map((prompt) => (
            <span
              class="prompt"
              data-prompt
              style={`left: ${prompt.at.x * 100}%; top: ${(1 - prompt.at.y) * 100}%`}
            >
              <span class="prompt-dot" aria-hidden="true" />
              <span class="prompt-text">{prompt.text}</span>
            </span>
          ))
        }

        <p class="invitation" data-testid="invitation">
          Move your mouse. Or press an arrow key.
        </p>
        <div class="cursor" data-testid="cursor" aria-hidden="true"></div>
      </div>

      <!--
        Shown while the hand model downloads and for a few seconds after
        tracking begins. Hand mappings are not discoverable --- nothing about
        a camera suggests that spreading your fingers widens the blend --- and
        the download is dead time this can occupy.
      -->
      <aside class="guide" data-testid="guide">
        <ul>
          <li>
            <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false">
              <path
                d="M6 31 Q 18 6 31 17"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-dasharray="3 3"
                stroke-linecap="round"></path>
              <circle cx="31" cy="17" r="4.5" fill="currentColor"></circle>
            </svg>
            <b>move your hand</b>
            <span>travel the field</span>
          </li>

          <li>
            <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false">
              <circle cx="20" cy="20" r="4.5" fill="currentColor"></circle>
              <circle
                cx="20"
                cy="20"
                r="10"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                opacity="0.55"></circle>
              <circle
                cx="20"
                cy="20"
                r="16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                opacity="0.25"></circle>
            </svg>
            <b>open your fingers</b>
            <span>blur across many — close to pick one out</span>
          </li>

          <li>
            <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false">
              <circle cx="20" cy="20" r="4" fill="currentColor"></circle>
              <g
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                opacity="0.7">
                <path d="M20 11 V4"></path>
                <path d="M20 29 V36"></path>
                <path d="M11 20 H4"></path>
                <path d="M29 20 H36"></path>
                <path d="M26.4 13.6 L31.4 8.6"></path>
                <path d="M13.6 26.4 L8.6 31.4"></path>
                <path d="M26.4 26.4 L31.4 31.4"></path>
                <path d="M13.6 13.6 L8.6 8.6"></path>
              </g>
            </svg>
            <b>move sharply</b>
            <span>stirs it up, then settles</span>
          </li>
        </ul>
      </aside>

      <div class="controls" id="controls">
        <button
          class="control"
          type="button"
          data-testid="hands"
          aria-pressed="false"
        >
          <span class="control-label">hands</span>
          <span class="control-value" data-testid="hands-value" aria-live="polite"
            >off</span
          >
        </button>
      </div>

      <!--
        Deliberately separate from .controls, and styled to look like a
        research annotation rather than a performance dial. Switching how the
        field is voiced is an A/B comparison you'd run once, in a lab sense --
        not something a performer reaches for mid-piece the way moving through
        the field or opening a hand is. Placing it beside the performance
        controls claimed an equal footing it hadn't earned.
      -->
      <button
        class="compare"
        type="button"
        data-testid="voicing"
        aria-pressed="false"
      >
        <span class="compare-label">compare voicing —</span>
        <span
          class="compare-value"
          data-testid="voicing-value"
          aria-live="polite">authored</span
        >
      </button>

      <video
        class="mirror"
        data-testid="mirror"
        playsinline
        muted
        aria-hidden="true"></video>
    </main>

    <script>
      import { start } from "../scripts/main";
      start();
    </script>
  </body>
</html>
